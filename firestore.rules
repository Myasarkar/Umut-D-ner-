rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Menü öğeleri koleksiyonu
    match /menu_items/{item} {
      // Menüyü herkes okuyabilir (QR kod okutan müşteriler)
      allow read: if true;

      // Sadece giriş yapmış ve yetkili e-posta adresine sahip kullanıcılar yazabilir
      // .env.local dosyanızdaki VITE_ADMIN_EMAIL ile eşleşmelidir
      allow write: if request.auth != null &&
                  (request.auth.token.email == 'labmyk@gmail.com');
    }
  }
}
