rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Menü öğeleri koleksiyonu
    match /menu_items/{item} {
      // Menüyü herkes okuyabilir (QR kod okutan müşteriler)
      allow read: if true;

      // Sadece admins koleksiyonunda kayıtlı kullanıcılar yazabilir
      allow write: if request.auth != null &&
                  exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Admin kontrolü: kullanıcı sadece kendi e-postasını sorgulayabilir
    match /admins/{email} {
      allow read: if request.auth != null &&
                  request.auth.token.email == email;
    }
  }
}
